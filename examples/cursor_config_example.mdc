# Example Cursor MCP Configuration for fckgit
# Add this to your Cursor MCP settings

# When Cursor reuses the server after a project switch, pass the new
# project's absolute repo_path on each MCP tool call.
mcpServers:
  fckgit:
    command: python
    args:
      - "-m"
      - "mcp_server"
    env:
      GEMINI_API_KEY: "your_api_key_here"
